# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is gitignored — never commit real secrets.
#
# On Streamlit Cloud (Wed D88), paste these same keys into
# App settings -> Secrets instead of uploading this file.

ANTHROPIC_API_KEY = "sk-ant-..."

# Shared password gating the app (Thu D79). This is a soft-launch tool
# for a handful of known people, not a multi-tenant product — a single
# shared password is a deliberate, proportionate choice. See auth.py.
APP_PASSWORD = "change-me"

# Google Form URL for the "Give feedback" button (Thu D89).
# See docs/feedback_form_setup.md for how to create one.
FEEDBACK_FORM_URL = "https://forms.gle/replace-with-real-form"
